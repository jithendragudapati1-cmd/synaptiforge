# Copy this file to .env and fill in your credentials locally.
# Do not commit .env or paste passwords into chat.
APP_BASE_URL=http://127.0.0.1:5000
COOKIE_SECURE=false
# Optional: use a long random secret. If blank, a persistent local key is generated.
SECRET_KEY=

# Google Cloud OAuth client: application type "Web application".
# Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail / Google Workspace sender. Use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Small-beta training limits
MAX_UPLOAD_MB=5
MAX_DATA_ROWS=10000
MAX_DATA_FEATURES=50
USER_STORAGE_MB=100
MAX_SAVED_JOBS=100
MAX_TRAIN_SECONDS=300
ALLOW_DEMOS=true
# Leave unset for local files. Use an absolute mounted directory in production.
SYNAPTIFORGE_STORAGE_DIR=

# Public support defaults to SMTP_USERNAME when left blank.
SUPPORT_EMAIL=
# Encrypted daily backups on the persistent volume. Keep a private off-host copy too.
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_KEEP=7
BACKUP_MAX_MB=1024
# Optional separate stable encryption secret; otherwise SECRET_KEY is used.
BACKUP_ENCRYPTION_KEY=

# Global small-beta safeguards (in addition to each user's quota).
MAX_ACCOUNTS=50
MAX_GLOBAL_QUEUED_JOBS=10
GLOBAL_STORAGE_MB=1024
MIN_FREE_DISK_MB=256
TRAINING_RESERVE_MB=8
MAX_EXPORT_MB=100
# Dedicated cloud-synced folder or mounted external backup directory.
BACKUP_SECONDARY_DIR=
